+static av_always_inline unsigned bc7_get_bits(const uint64_t bits[2], int *pos, int n)
+{
+    const int p = *pos;
+    uint64_t v;
+
+    if (p >= 64) {
+        v = bits[1] >> (p - 64);
+    } else {
+        v = bits[0] >> p;
+        if (p + n > 64)
+            v |= bits[1] << (64 - p);
+    }
+    *pos = p + n;
+    return v & ((1U << n) - 1);
+}
+
+int ff_bc7_decode_block(uint8_t *dst, ptrdiff_t stride, const uint8_t *block)
+{
+    const uint64_t bits[2] = { AV_RL64(block), AV_RL64(block + 8) };
+    const BC7ModeInfo *mi;
+    const uint8_t *part = NULL, *cidx, *aidx, *wc, *wa;
+    uint8_t prim[16], sec[16];
+    int mode, partition, rotation, isb, has_p, pos;
+    int ep[3][2][4], pbit[3][2] = { { 0 } };
+
+    if (!block[0]) {
+        /* reserved mode: transparent black */
+        for (int y = 0; y < 4; y++)
+            memset(dst + y * stride, 0, 16);
+        return 16;
+    }
+    mode      = ff_ctz(block[0]);
+    mi        = &ff_bc7_modes[mode];
+    pos       = mode + 1;
+    partition = bc7_get_bits(bits, &pos, mi->pb);
+    rotation  = bc7_get_bits(bits, &pos, mi->rb);
+    isb       = bc7_get_bits(bits, &pos, mi->isb);
+    has_p     = mi->epb || mi->spb;
+
+    for (int c = 0; c < 3; c++)
+        for (int s = 0; s < mi->ns; s++)
+            for (int e = 0; e < 2; e++)
+                ep[s][e][c] = bc7_get_bits(bits, &pos, mi->cb);
+    for (int s = 0; s < mi->ns; s++)
+        for (int e = 0; e < 2; e++)
+            ep[s][e][3] = bc7_get_bits(bits, &pos, mi->ab);
+    if (mi->epb)
+        for (int s = 0; s < mi->ns; s++)
+            for (int e = 0; e < 2; e++)
+                pbit[s][e] = bc7_get_bits(bits, &pos, 1);
+    if (mi->spb)
+        for (int s = 0; s < mi->ns; s++)
+            pbit[s][0] = pbit[s][1] = bc7_get_bits(bits, &pos, 1);
+
+    for (int s = 0; s < mi->ns; s++) {
+        for (int e = 0; e < 2; e++) {
+            for (int c = 0; c < 3; c++)
+                ep[s][e][c] = bc7_unquant((ep[s][e][c] << has_p) | pbit[s][e], mi->cb + has_p);
+            ep[s][e][3] = mi->ab ? bc7_unquant((ep[s][e][3] << has_p) | pbit[s][e], mi->ab + has_p)
+                                 : 255;
+        }
+    }
+
+    if (mi->ns > 1)
+        part = mi->ns == 2 ? ff_bc7_partition2[partition] : ff_bc7_partition3[partition];
+    for (int i = 0; i < 16; i++)
+        prim[i] = bc7_get_bits(bits, &pos, mi->ib - bc7_is_anchor(mi->ns, partition, i));
+    for (int i = 0; i < 16 && mi->ib2; i++)
+        sec[i] = bc7_get_bits(bits, &pos, mi->ib2 - !i);
+
+    /* the index selection bit swaps the colour and alpha index sets */
+    cidx = isb ? sec  : prim;
+    aidx = !mi->ib2 ? prim : isb ? prim : sec;
+    wc   = ff_bc7_weights[isb ? mi->ib2 : mi->ib];
+    wa   = ff_bc7_weights[!mi->ib2 ? mi->ib : isb ? mi->ib : mi->ib2];
+
+    for (int i = 0; i < 16; i++) {
+        const int s = part ? part[i] : 0;
+        uint8_t *p = dst + (i >> 2) * stride + (i & 3) * 4;
+        int v[4];
+
+        for (int c = 0; c < 3; c++)
+            v[c] = (ep[s][0][c] * (64 - wc[cidx[i]]) + ep[s][1][c] * wc[cidx[i]] + 32) >> 6;
+        v[3] = (ep[s][0][3] * (64 - wa[aidx[i]]) + ep[s][1][3] * wa[aidx[i]] + 32) >> 6;
+        if (rotation)
+            FFSWAP(int, v[rotation - 1], v[3]);
+        for (int c = 0; c < 4; c++)
+            p[c] = v[c];
+    }
+
+    return 16;
+}
