+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/**
+ * @file
+ * BC7 / BPTC (GL_COMPRESSED_RGBA_BPTC_UNORM, DXGI_FORMAT_BC7_UNORM)
+ *
+ * Block format: ARB_texture_compression_bptc
+ * https://registry.khronos.org/OpenGL/extensions/ARB/ARB_texture_compression_bptc.txt
+ */
+
+#ifndef AVCODEC_BC7_H
+#define AVCODEC_BC7_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct BC7ModeInfo {
+    uint8_t ns;     ///< number of subsets
+    uint8_t pb;     ///< partition bits
+    uint8_t rb;     ///< rotation bits
+    uint8_t isb;    ///< index selection bit
+    uint8_t cb;     ///< colour bits per endpoint channel
+    uint8_t ab;     ///< alpha bits per endpoint
+    uint8_t epb;    ///< one p-bit per endpoint
+    uint8_t spb;    ///< one p-bit per subset
+    uint8_t ib;     ///< primary index bits
+    uint8_t ib2;    ///< secondary index bits
+} BC7ModeInfo;
+
+extern const BC7ModeInfo ff_bc7_modes[8];
+
+/** interpolation weights, indexed by the number of index bits (2 to 4) */
+extern const uint8_t *const ff_bc7_weights[5];
+
+extern const uint8_t ff_bc7_partition2[64][16];
+extern const uint8_t ff_bc7_partition3[64][16];
+
+/** anchor index of the second subset of 2-subset partitions */
+extern const uint8_t ff_bc7_anchor2[64];
+/** anchor index of the second subset of 3-subset partitions */
+extern const uint8_t ff_bc7_anchor3a[64];
+/** anchor index of the third subset of 3-subset partitions */
+extern const uint8_t ff_bc7_anchor3b[64];
+
+/** Expand an n bit endpoint value (including the p-bit) to 8 bits. */
+static inline int bc7_unquant(int x, int n)
+{
+    return (x << (8 - n)) | (x >> (2 * n - 8));
+}
+
+/** Whether pixel i holds the anchor index of one of the ns subsets. */
+static inline int bc7_is_anchor(int ns, int partition, int i)
+{
+    if (!i)
+        return 1;
+    if (ns == 2)
+        return i == ff_bc7_anchor2[partition];
+    if (ns == 3)
+        return i == ff_bc7_anchor3a[partition] || i == ff_bc7_anchor3b[partition];
+    return 0;
+}
+
+/**
+ * Decompress one BC7 block to 4x4 RGBA pixels.
+ *
+ * @param dst    output buffer
+ * @param stride scanline of the output in bytes
+ * @param block  16 bytes of BC7 data
+ * @return how much texture data has been read (16)
+ */
+int ff_bc7_decode_block(uint8_t *dst, ptrdiff_t stride, const uint8_t *block);
+
+/**
+ * Compress one 4x4 block of RGBA pixels into a 16 byte BC7 block.
+ *
+ * @param dst    output buffer (16 bytes)
+ * @param stride scanline of the input in bytes
+ * @param block  top left pixel of the block to compress
+ * @return how much texture data has been written (16)
+ */
+int ff_bc7_encode_block(uint8_t *dst, ptrdiff_t stride, const uint8_t *block);
+
+#endif /* AVCODEC_BC7_H */
